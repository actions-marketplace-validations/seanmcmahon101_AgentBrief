{
  "schema": "agentbrief/brief/v1",
  "scope": ".",
  "toolchain": [
    {
      "name": "node",
      "version": "^20.19.0 || >=22.12.0",
      "sources": [
        "package.json"
      ]
    }
  ],
  "package_managers": [
    {
      "name": "pnpm",
      "version": "12.9.1",
      "ecosystem": "node",
      "source": "package.json",
      "avoid": [
        "npm",
        "yarn"
      ]
    }
  ],
  "commands": [
    {
      "kind": "install",
      "run": "pnpm install",
      "dir": ".",
      "source": "pnpm convention, unverified",
      "evidence": [
        "convention"
      ],
      "verified": false
    },
    {
      "kind": "build",
      "run": "pnpm build",
      "dir": ".",
      "source": "package.json, CI",
      "evidence": [
        "ci",
        "declared"
      ],
      "verified": true
    },
    {
      "kind": "test",
      "run": "pnpm test",
      "dir": ".",
      "source": "package.json",
      "evidence": [
        "declared"
      ],
      "verified": true
    },
    {
      "kind": "test-single",
      "run": "pnpm exec vitest run <file> -t \"<name>\"",
      "dir": ".",
      "source": "vitest convention, unverified",
      "evidence": [
        "convention"
      ],
      "verified": false
    },
    {
      "kind": "lint",
      "run": "pnpm lint",
      "dir": ".",
      "source": "package.json, CI",
      "evidence": [
        "ci",
        "declared"
      ],
      "verified": true
    },
    {
      "kind": "format",
      "run": "pnpm format",
      "dir": ".",
      "source": "package.json, CI",
      "evidence": [
        "ci",
        "declared"
      ],
      "verified": true
    },
    {
      "kind": "typecheck",
      "run": "pnpm typecheck",
      "dir": ".",
      "source": "package.json, CI",
      "evidence": [
        "ci",
        "declared"
      ],
      "verified": true
    },
    {
      "kind": "dev",
      "run": "pnpm dev",
      "dir": ".",
      "source": "package.json",
      "evidence": [
        "declared"
      ],
      "verified": true
    }
  ],
  "ecosystems": [],
  "workspace": {
    "kind": "workspace",
    "manager": "pnpm",
    "count": 4,
    "members": [
      {
        "dir": "docs",
        "name": "@vitejs/monorepo-docs",
        "ecosystem": "node"
      },
      {
        "dir": "packages/create-vite",
        "name": "create-vite",
        "ecosystem": "node"
      },
      {
        "dir": "packages/plugin-legacy",
        "name": "@vitejs/plugin-legacy",
        "ecosystem": "node"
      },
      {
        "dir": "packages/vite",
        "name": "vite",
        "ecosystem": "node"
      }
    ],
    "omitted": 0
  },
  "do_not_edit": [
    {
      "pattern": "pnpm-lock.yaml",
      "reason": "lockfile",
      "patterns": [
        "pnpm-lock.yaml"
      ]
    }
  ],
  "instruction_files": [
    ".github/copilot-instructions.md"
  ],
  "notes": []
}
